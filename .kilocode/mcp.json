{
  "mcpServers": {
    "qdrant": {
      "command": "uvx",
      "args": [
        "mcp-server-qdrant",
        "--transport",
        "sse"
      ],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "FASTMCP_PORT": 6767,
        "COLLECTION_NAME": "ws-9ad8ddce7d4510f3",
        "EMBEDDING_PROVIDER": "Ollama",
        "EMBEDDING_MODEL": "nomic-embed-text:latest",
        "OLLAMA_HOST": "http://localhost:11434"
      }
    }
  }
}